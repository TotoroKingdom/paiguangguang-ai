IMAGE_NAME=ghcr.io/your-org/paiguangguang-ai:latest
BACKEND_IMAGE_NAME=ghcr.io/your-org/paiguangguang-ai-backend:latest
ASSISTANT_OWNER_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
ASSISTANT_OWNER_COOKIE_SECURE=true
ASSISTANT_ALLOWED_ORIGINS=https://your-domain.example
ASSISTANT_DATA_VOLUME=paiguangguang-ai-assistant-data
