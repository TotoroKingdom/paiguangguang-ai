IMAGE_NAME=ghcr.io/your-org/paiguangguang-ai:latest
BACKEND_IMAGE_NAME=ghcr.io/your-org/paiguangguang-ai-backend:latest
ASSISTANT_ENVIRONMENT=production
ASSISTANT_OWNER_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
ASSISTANT_OWNER_COOKIE_SECURE=true
ASSISTANT_ALLOWED_ORIGINS=https://your-domain.example
ASSISTANT_ADMIN_COOKIE_SECURE=true
ASSISTANT_ADMIN_USERNAME=admin
ASSISTANT_ADMIN_PASSWORD=replace-with-a-random-administrator-password
ASSISTANT_DATA_VOLUME=paiguangguang-ai-assistant-data
ASSISTANT_LLM_PROVIDER=openai
ASSISTANT_LLM_BASE_URL=https://api.example.com/v1
ASSISTANT_LLM_MODEL=replace-with-approved-model
ASSISTANT_LLM_API_KEY=replace-with-provider-api-key
